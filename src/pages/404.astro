---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro";
import { rutas } from "../i18n";
import { ui } from "../i18n/ui";

// GitHub Pages sirve esta misma página para cualquier ruta inexistente, así que
// muestra el mensaje en los dos idiomas.
const { es, en } = ui;
---

<Layout lang="es" title={`${es.noEncontrada.titulo} · Daniel Pons`} description={es.noEncontrada.texto} alternos={{ es: rutas.inicio("es"), en: rutas.inicio("en") }}>
    <section class="flex flex-col items-center max-w-xl px-4 py-24 mx-auto text-center sm:px-6">
        <Avatar class="size-28" alt="" />
        <p class="mt-8 font-mono text-sm font-medium text-acento">404</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-tinta">{es.noEncontrada.titulo}</h1>
        <p class="mt-3 text-tinta-2">{es.noEncontrada.texto}</p>
        <p class="mt-1 text-sm text-tinta-2" lang="en">{en.noEncontrada.texto}</p>
        <div class="flex flex-wrap justify-center gap-3 mt-8">
            <a href={rutas.inicio("es")} class="inline-flex items-center px-5 font-medium rounded-lg h-11 bg-acento text-acento-tinta hover:opacity-90">
                {es.noEncontrada.volver}
            </a>
            <a href={rutas.inicio("en")} lang="en" class="inline-flex items-center px-5 font-medium border rounded-lg h-11 border-borde bg-superficie text-tinta hover:border-acento">
                {en.noEncontrada.volver}
            </a>
        </div>
    </section>
</Layout>
