---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import Social from "../components/Social.astro";
import GitHub from "../icons/GitHub.astro";
import Mail from "../icons/Mail.astro";
import TimeLine from "../components/TimeLine.astro";
import Section from "../components/Section.astro";
import Suitcase from "../icons/Suitcase.astro";
import Code from "../icons/Code.astro";
import Projects from "../components/Projects.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Stack from "../components/Stack.astro";
import Education from "../components/Education.astro";
import LivePipeline from "../components/LivePipeline.astro";
import Database from "../icons/Database.astro";
import StackIcon from "../icons/Stack.astro";
import School from "../icons/School.astro";
import Activity from "../icons/Activity.astro";
import { withBase } from "../utils/url";

const Destacados = [
	{ value: "−70%", label: "tiempo de ejecución en un flujo crítico" },
	{ value: "15+", label: "procesos migrados de RPA a Python y Prefect" },
	{ value: "8", label: "APIs y servicios empresariales integrados" },
];
---

<Layout
	title="Daniel Pons · Data Engineer | Pipelines, automatización e integraciones"
	description="Portafolio de Daniel Pons, Ingeniero Informático: pipelines de datos con Python, Pandas y Prefect, integraciones con APIs empresariales y CI/CD con GitHub Actions."
>
	<main class="px-4">
		
		<Section class="py-44 pb-32" id="inicio">
			<img
				class="rounded-full size-12 mb-4 object-cover "
				src={withBase("/projects/icons8-persona-64.png")}
				alt="Daniel Pons"
			/>
			<h1
				class="text-3xl md:text-4xl lg:text-5xl font-semibold flex flex-row flex-wrap gap-4 pb-6 lg:pb-10 text-blue-950"
			>
				Daniel Pons<a
					href="https://linkedin.com/in/danielponsg"
					target="_blank"
					class="flex flex-col justify-center hover:scale-105 hover:transition-all transition-all md:hover:scale-105"
				>
					<Badge> Abierto a desafíos en Data Engineering </Badge></a
				>
			</h1>
			<h2
				class="text-xl text-pretty max-w-[700px] text-blue-950"
			>
				Ingeniero Informático enfocado en Data Engineering. Construyo
				pipelines de datos con Python, Pandas y Prefect, integro APIs
				empresariales y automatizo su prueba y despliegue con GitHub
				Actions. También desarrollo sitios y aplicaciones web, como este.
			</h2>

			<dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8 max-w-[700px]">
				{
					Destacados.map(({ value, label }) => (
						<div class="p-4 bg-white/70 border border-blue-100 rounded-lg">
							<dt class="sr-only">{label}</dt>
							<dd class="text-3xl font-semibold text-blue-800">{value}</dd>
							<dd class="text-sm text-blue-950">{label}</dd>
						</div>
					))
				}
			</dl>

			<nav class="flex gap-4 mt-8 flex-wrap">
				<Social href="https://linkedin.com/in/danielponsg">
					<LinkedIn class="size-4 md:size-6" />
					LinkedIn
				</Social>
				<Social href="https://github.com/DanielPonsG">
					<GitHub class="size-4 md:size-6" />
					GitHub
				</Social>
				<Social href="mailto:danielpons44@gmail.com">
					<Mail class="size-4 md:size-6" />
					Danielpons44@gmail.com
				</Social>
			</nav>
		</Section>

		<Section class="pb-20" id="experiencia">
			<h2
				class="text-3xl md:text-4xl font-semibold mb-6 flex gap-x-3 items-center text-blue-950"
			>
				<Suitcase class="size-7 shrink-0" />
				Experiencia
			</h2>
			<TimeLine />
		</Section>

		<Section class="pb-20" id="casos">
			<h2 class="text-3xl md:text-4xl font-semibold mb-2 flex gap-x-3 items-center text-blue-950">
				<Database class="size-7 shrink-0" />
				Casos de Data Engineering
			</h2>
			<p class="mb-6 text-base text-blue-950/80 max-w-[700px]">
				Procesos que desarrollé en mi trabajo actual en el sector financiero.
				Omito nombres de clientes, bancos e información interna.
			</p>
			<CaseStudies />
		</Section>

		<Section class="pb-20" id="pipeline">
			<h2 class="text-3xl md:text-4xl font-semibold mb-2 flex gap-x-3 items-center text-blue-950">
				<Activity class="size-7 shrink-0" />
				Pipeline en vivo
			</h2>
			<p class="mb-6 text-base text-blue-950/80 max-w-[700px]">
				Un ETL en Python que corre cada lunes con GitHub Actions: descarga
				indicadores económicos públicos de Chile, valida su calidad con
				Pandas, actualiza un histórico versionado en Git y vuelve a publicar
				este sitio. Si un dato no pasa las validaciones, el pipeline se
				detiene sin publicar nada.
			</p>
			<LivePipeline />
		</Section>

		<Section class="pb-20" id="stack">
			<h2 class="text-3xl md:text-4xl font-semibold mb-6 flex gap-x-3 items-center text-blue-950">
				<StackIcon class="size-7 shrink-0" />
				Stack
			</h2>
			<Stack />
		</Section>

		<Section class="pb-20" id="proyectos">
			<h2 class="text-3xl md:text-4xl font-semibold mb-6 flex gap-x-3 items-center text-blue-950">
				<Code class="size-7 shrink-0" />
				Proyectos
			</h2>
			<Projects />
		</Section>

		<Section id="formacion">
			<h2 class="text-3xl md:text-4xl font-semibold mb-6 flex gap-x-3 items-center text-blue-950">
				<School class="size-7 shrink-0" />
				Formación
			</h2>
			<Education />
		</Section>
	</main>
</Layout>
