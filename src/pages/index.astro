---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import Social from "../components/Social.astro";
import GitHub from "../icons/GitHub.astro";
import Mail from "../icons/Mail.astro";
import TimeLine from "../components/TimeLine.astro";
import Section from "../components/Section.astro";
import Suitcase from "../icons/Suitcase.astro";
import Code from "../icons/Code.astro";
import Projects from "../components/Projects.astro";
import { withBase } from "../utils/url";
---

<Layout
	title="Daniel Pons · Ingeniero Informático | Automatización y Data Engineering"
	description="Portfolio de Daniel Pons, Ingeniero Informático especializado en automatización de procesos, integraciones con APIs y pipelines de datos con Python."
>
	<main class="px-4">
		
		<Section class="py-44 pb-32" id="inicio">
			<img
				class="rounded-full size-12 mb-4 object-cover "
				src={withBase("/projects/icons8-persona-64.png")}
				alt="Daniel Pons"
			/>
			<h1
				class="text-3xl md:text-4xl lg:text-5xl font-semibold flex flex-row flex-wrap gap-4 pb-6 lg:pb-10 text-blue-950"
			>
				Daniel Pons<a
					href="https://linkedin.com/in/danielponsg"
					target="_blank"
					class="flex flex-col justify-center hover:scale-105 hover:transition-all transition-all md:hover:scale-105"
				>
					<Badge> Disponible para trabajar </Badge></a
				>
			</h1>
			<h2
				class="text-xl text-pretty max-w-[700px] text-blue-950"
			>
				Ingeniero Informático enfocado en automatización, integraciones y
				Data Engineering. Diseño soluciones end-to-end con Python y Pandas,
				integro APIs empresariales y automatizo el ciclo de desarrollo con
				GitHub Actions.
			</h2>

			<nav class="flex gap-4 mt-8 flex-wrap">
				<Social href="https://linkedin.com/in/danielponsg">
					<LinkedIn class="size-4 md:size-6" />
					LinkedIn
				</Social>
				<Social href="https://github.com/DanielPonsG">
					<GitHub class="size-4 md:size-6" />
					GitHub
				</Social>
				<Social href="mailto:danielpons44@gmail.com">
					<Mail class="size-4 md:size-6" />
					Danielpons44@gmail.com
				</Social>
			</nav>
		</Section>

		<Section class="pb-20" id="experiencia">
			<h2
				class="text-4xl font-semibold mb-6 flex gap-x-3 items-center text-blue-950"
			>
				<Suitcase class="size-7" />
				Experiencia
			</h2>
			<TimeLine />
		</Section>

		<Section id="proyectos">
			<h2 class="text-4xl font-semibold mb-6 flex gap-x-3 items-center text-blue-950">
				<Code class="size-7" />
				Proyectos
			</h2>
			<Projects />
		</Section>
	</main>
</Layout>
