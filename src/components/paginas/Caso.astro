---
import Layout from "../../layouts/Layout.astro";
import Flow from "../Flow.astro";
import ArrowLeft from "../../icons/ArrowLeft.astro";
import ArrowRight from "../../icons/ArrowRight.astro";
import { rutas, seccion, type Idioma } from "../../i18n";
import { ui } from "../../i18n/ui";
import { casos } from "../../data/casos";

interface Props {
    lang: Idioma;
    slug: string;
}
const { lang, slug } = Astro.props;
const t = ui[lang];
const caso = casos[lang].find((c) => c.slug === slug)!;
const otros = casos[lang].filter((c) => c.slug !== slug);
const bloques = [
    { titulo: t.caso.problema, texto: caso.problema },
    { titulo: t.caso.solucion, texto: caso.solucion },
];
---

<!-- DETALLE DE UN CASO: PROBLEMA, SOLUCIÓN, RESULTADO Y FLUJO -->
<Layout
    lang={lang}
    title={`${caso.titulo} · Daniel Pons`}
    description={caso.resumen}
    alternos={{ es: rutas.caso("es", slug), en: rutas.caso("en", slug) }}
>
    <article class="w-full max-w-3xl px-4 pt-10 mx-auto sm:px-6 md:pt-16">
        <a href={seccion(lang, "casos")} class="inline-flex items-center text-sm font-medium gap-x-1.5 text-tinta-2 hover:text-acento">
            <ArrowLeft class="size-4" aria-hidden="true" />
            {t.caso.volver}
        </a>

        <header class="mt-8">
            <p class="font-mono text-xs font-medium tracking-widest uppercase text-acento">{caso.area}</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl text-balance text-tinta">{caso.titulo}</h1>
            <p class="mt-4 text-lg text-pretty text-tinta-2">{caso.resumen}</p>
        </header>

        <div class="p-5 mt-8 border rounded-2xl border-borde bg-superficie">
            <h2 class="mb-3 font-mono text-xs font-semibold tracking-widest uppercase text-tinta-2">{t.caso.flujo}</h2>
            <Flow pasos={caso.flujo} etiqueta={t.caso.flujo} />
        </div>

        <div class="mt-10 space-y-8">
            {
                bloques.map(({ titulo, texto }) => (
                    <section>
                        <h2 class="text-xl font-semibold tracking-tight text-tinta">{titulo}</h2>
                        <p class="mt-2 leading-relaxed text-tinta-2">{texto}</p>
                    </section>
                ))
            }
            <section class="p-5 border-s-4 rounded-e-2xl border-acento bg-acento-suave/60">
                <h2 class="text-xl font-semibold tracking-tight text-tinta">{t.caso.resultado}</h2>
                <p class="mt-2 leading-relaxed text-tinta">{caso.resultado}</p>
            </section>
            <section>
                <h2 class="text-xl font-semibold tracking-tight text-tinta">{t.caso.stack}</h2>
                <ul class="flex flex-wrap gap-1.5 mt-3">
                    {caso.stack.map((tecnologia) => (
                        <li class="px-2.5 py-1 text-sm rounded-md bg-superficie-2 text-tinta">{tecnologia}</li>
                    ))}
                </ul>
            </section>
        </div>

        <p class="pt-6 mt-10 text-sm border-t border-borde text-tinta-2">{t.caso.nota}</p>
    </article>

    <section class="w-full max-w-5xl px-4 mx-auto mt-16 sm:px-6" aria-labelledby="otros-casos">
        <h2 id="otros-casos" class="mb-5 text-2xl font-semibold tracking-tight text-tinta">{t.caso.otros}</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
            {
                otros.map((otro) => (
                    <li>
                        <a
                            href={rutas.caso(lang, otro.slug)}
                            class="flex flex-col h-full p-5 transition-colors border group rounded-2xl border-borde bg-superficie hover:border-acento"
                        >
                            <p class="font-mono text-xs font-medium tracking-widest uppercase text-acento">{otro.area}</p>
                            <h3 class="mt-2 font-semibold text-tinta">{otro.titulo}</h3>
                            <span class="inline-flex items-center pt-4 mt-auto text-sm font-medium gap-x-1 text-acento">
                                {t.secciones.casos.verCaso}
                                <ArrowRight class="transition-transform size-4 group-hover:translate-x-0.5" aria-hidden="true" />
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
</Layout>
