---
import ArrowUpRight from "../icons/ArrowUpRight.astro";
import School from "../icons/School.astro";
import type { Idioma } from "../i18n";
import { ui } from "../i18n/ui";
import { proyectos } from "../data/perfil";
import { withBase } from "../utils/url";

interface Props {
    lang: Idioma;
}
const { lang } = Astro.props;
const t = ui[lang].secciones.proyectos;
---

<!-- PROYECTOS PERSONALES Y ACADÉMICOS -->
<ul class="grid gap-4 md:grid-cols-2">
    {
        proyectos[lang].map(({ titulo, descripcion, imagen, enlace, tags }) => (
            <li class="flex flex-col overflow-hidden border rounded-2xl border-borde bg-superficie">
                <div class="overflow-hidden border-b aspect-video border-borde bg-superficie-2">
                    {imagen ? (
                        <img class="object-cover object-top w-full h-full" src={withBase(imagen)} alt="" loading="lazy" width="1280" height="720" />
                    ) : (
                        <div class="relative grid w-full h-full place-items-center bg-[radial-gradient(ellipse_at_center,var(--acento-suave),transparent_70%)]">
                            <span class="grid rounded-2xl size-16 place-items-center bg-superficie text-acento ring-1 ring-borde">
                                <School class="size-8" aria-hidden="true" />
                            </span>
                            <span class="absolute font-mono text-xs bottom-4 text-tinta-2">{tags.slice(0, 3).join(" · ")}</span>
                        </div>
                    )}
                </div>
                <div class="flex flex-col flex-1 p-6">
                    <h3 class="text-lg font-semibold tracking-tight text-tinta">{titulo}</h3>
                    <p class="mt-2 text-tinta-2">{descripcion}</p>
                    <ul class="flex flex-wrap gap-1.5 mt-5">
                        {tags.map((tag) => (
                            <li class="px-2 py-0.5 text-xs rounded-md bg-superficie-2 text-tinta-2">{tag}</li>
                        ))}
                    </ul>
                    <p class="pt-5 mt-auto text-sm font-medium">
                        {enlace ? (
                            <a class="inline-flex items-center gap-x-1 text-acento hover:underline" href={enlace} target="_blank" rel="noopener noreferrer">
                                {t.verCodigo}
                                <ArrowUpRight class="size-3.5" aria-hidden="true" />
                            </a>
                        ) : (
                            <span class="text-tinta-2">{t.privado}</span>
                        )}
                    </p>
                </div>
            </li>
        ))
    }
</ul>
