---
import type { Idioma } from "../i18n";
import { stack } from "../data/perfil";

interface Props {
    lang: Idioma;
}
const { lang } = Astro.props;
---

<!-- STACK AGRUPADO POR CAPA DEL TRABAJO CON DATOS -->
<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
        stack[lang].map(({ titulo, descripcion, items }) => (
            <li class="p-5 border rounded-2xl border-borde bg-superficie">
                <h3 class="font-semibold text-tinta">{titulo}</h3>
                <p class="mt-1 text-sm text-tinta-2">{descripcion}</p>
                <ul class="flex flex-wrap gap-1.5 mt-4">
                    {items.map((item) => (
                        <li class="px-2 py-0.5 text-xs rounded-md bg-superficie-2 text-tinta">{item}</li>
                    ))}
                </ul>
            </li>
        ))
    }
</ul>
