---
import Flow from "./Flow.astro";
import datos from "../data/indicadores.json";

// El pipeline de /pipeline escribe este JSON en cada ejecución.
interface Indicador {
    codigo: string;
    nombre: string;
    unidad: string;
    decimales: number;
    ultimo: { fecha: string; valor: number };
    variacion: number | null;
    serie: [string, number][];
}

const indicadores = datos.indicadores as Indicador[];
const REPO = "https://github.com/DanielPonsG/Portfolio-dev";

const pasos = [
    "API pública",
    "Extracción con reintentos",
    "Validación con Pandas",
    "Histórico en Git",
    "Build con Astro",
    "GitHub Pages",
];

const moneda = (valor: number, unidad: string, decimales: number) =>
    new Intl.NumberFormat("es-CL", {
        style: "currency",
        currency: unidad,
        minimumFractionDigits: decimales,
        maximumFractionDigits: decimales,
    }).format(valor);

const dia = (iso: string) =>
    new Intl.DateTimeFormat("es-CL", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(
        new Date(`${iso}T00:00:00Z`),
    );

const porcentaje = new Intl.NumberFormat("es-CL", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const variacion = (valor: number | null) => {
    if (valor === null) return "Sin datos para comparar";
    if (valor === 0) return `Sin cambio en ${datos.dias_variacion} días`;
    const flecha = valor > 0 ? "▲" : "▼";
    return `${flecha} ${porcentaje.format(Math.abs(valor))} % en ${datos.dias_variacion} días`;
};

const generado = datos.generado
    ? new Intl.DateTimeFormat("es-CL", {
          dateStyle: "long",
          timeStyle: "short",
          timeZone: "America/Santiago",
      }).format(new Date(datos.generado))
    : null;

// Geometría de las sparklines, en unidades del viewBox.
const ANCHO = 300;
const ALTO = 72;
const MARGEN = 6;

function grafico(serie: [string, number][]) {
    const valores = serie.map(([, valor]) => valor);
    const minimo = Math.min(...valores);
    const maximo = Math.max(...valores);
    const rango = maximo - minimo || 1;
    const paso = (ANCHO - 2 * MARGEN) / Math.max(serie.length - 1, 1);
    const puntos = valores.map((valor, i) => [
        +(MARGEN + i * paso).toFixed(1),
        +(MARGEN + ((maximo - valor) / rango) * (ALTO - 2 * MARGEN)).toFixed(1),
    ]);
    const linea = puntos.map(([x, y], i) => `${i ? "L" : "M"}${x},${y}`).join("");
    const [primero] = puntos;
    const ultimo = puntos[puntos.length - 1];
    const area = `${linea}L${ultimo[0]},${ALTO}L${primero[0]},${ALTO}Z`;
    return { puntos, linea, area, ultimo, minimo, maximo };
}
---

<!-- PIPELINE EN VIVO: RESULTADO DE LA ÚLTIMA EJECUCIÓN DEL ETL -->
<div class="p-5 bg-white rounded-lg shadow-md">
    <Flow pasos={pasos} />

    <p class="flex items-start gap-x-2 text-sm text-blue-950">
        {
            generado ? (
                <>
                    <span class="size-2 mt-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true" />
                    <span>
                        Última ejecución: <strong class="font-semibold">{generado}</strong> (hora de Chile) ·{" "}
                        {datos.registros.toLocaleString("es-CL")} registros en el histórico
                    </span>
                </>
            ) : (
                <span>La primera ejecución del pipeline publicará aquí sus resultados.</span>
            )
        }
    </p>

    {
        indicadores.length > 0 && (
            <div class="grid gap-4 mt-5 sm:grid-cols-2">
                {indicadores.map((indicador) => {
                    const { puntos, linea, area, ultimo, minimo, maximo } = grafico(indicador.serie);
                    const valor = (v: number) => moneda(v, indicador.unidad, indicador.decimales);
                    return (
                        <article
                            class="p-4 border border-blue-100 rounded-lg bg-blue-50/40"
                            data-sparkline
                            data-puntos={JSON.stringify(puntos)}
                            data-serie={JSON.stringify(indicador.serie)}
                            data-unidad={indicador.unidad}
                            data-decimales={indicador.decimales}
                        >
                            <h3 class="text-sm font-medium text-blue-950/80">{indicador.nombre}</h3>
                            <p class="text-2xl font-semibold text-blue-950">{valor(indicador.ultimo.valor)}</p>
                            <p class="text-sm text-blue-950/80">{variacion(indicador.variacion)}</p>
                            <svg
                                class="block w-full h-auto mt-3 overflow-visible cursor-crosshair rounded-sm focus:outline-2 focus:outline-offset-4 focus:outline-blue-500"
                                viewBox={`0 0 ${ANCHO} ${ALTO}`}
                                role="img"
                                tabindex="0"
                                aria-label={`${indicador.nombre} en los últimos 12 meses: mínimo ${valor(minimo)}, máximo ${valor(maximo)}. Use las flechas para recorrer los valores.`}
                            >
                                <path d={area} fill="#1d4ed8" fill-opacity="0.1" />
                                <path
                                    d={linea}
                                    fill="none"
                                    stroke="#1d4ed8"
                                    stroke-width="2"
                                    stroke-linejoin="round"
                                    stroke-linecap="round"
                                    vector-effect="non-scaling-stroke"
                                />
                                <line
                                    data-guia
                                    y1="0"
                                    y2={ALTO}
                                    stroke="#94a3b8"
                                    stroke-width="1"
                                    vector-effect="non-scaling-stroke"
                                    visibility="hidden"
                                />
                                <circle cx={ultimo[0]} cy={ultimo[1]} r="4" fill="#1d4ed8" stroke="#fff" stroke-width="2" />
                                <circle data-marca r="4" fill="#1d4ed8" stroke="#fff" stroke-width="2" visibility="hidden" />
                            </svg>
                            <p class="mt-1 text-xs text-blue-950/70" data-lectura aria-live="polite">
                                Al {dia(indicador.ultimo.fecha)} · últimos 12 meses
                            </p>
                        </article>
                    );
                })}
            </div>
        )
    }

    {
        indicadores.length > 0 && (
            <details class="mt-4 text-sm text-blue-950">
                <summary class="cursor-pointer font-medium text-blue-800">Ver los datos en una tabla</summary>
                <div class="mt-2 overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="text-blue-950/70">
                            <tr>
                                <th class="py-1 pe-4 font-medium">Indicador</th>
                                <th class="py-1 pe-4 font-medium">Fecha</th>
                                <th class="py-1 pe-4 font-medium text-right">Último valor</th>
                                <th class="py-1 font-medium text-right">Variación {datos.dias_variacion} días</th>
                            </tr>
                        </thead>
                        <tbody>
                            {indicadores.map((indicador) => (
                                <tr class="border-t border-blue-100">
                                    <td class="py-1 pe-4">{indicador.nombre}</td>
                                    <td class="py-1 pe-4 whitespace-nowrap">{dia(indicador.ultimo.fecha)}</td>
                                    <td class="py-1 pe-4 text-right whitespace-nowrap">
                                        {moneda(indicador.ultimo.valor, indicador.unidad, indicador.decimales)}
                                    </td>
                                    <td class="py-1 text-right whitespace-nowrap">
                                        {indicador.variacion === null ? "–" : `${porcentaje.format(indicador.variacion)} %`}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </details>
        )
    }

    <ul class="flex flex-wrap gap-x-5 gap-y-2 mt-4 text-sm font-medium text-blue-800">
        <li><a class="hover:underline" href={`${REPO}/tree/main/pipeline`} target="_blank" rel="noopener noreferrer">Código del pipeline</a></li>
        <li><a class="hover:underline" href={`${REPO}/actions/workflows/pipeline.yml`} target="_blank" rel="noopener noreferrer">Historial de ejecuciones</a></li>
        <li><a class="hover:underline" href={`${REPO}/blob/main/data/indicadores.csv`} target="_blank" rel="noopener noreferrer">Histórico en CSV</a></li>
        <li>Fuente: <a class="hover:underline" href="https://mindicador.cl" target="_blank" rel="noopener noreferrer">mindicador.cl</a></li>
    </ul>
</div>

<script>
    // Crosshair de las sparklines: con el puntero o con las flechas del teclado
    // se muestra el valor y la fecha del punto más cercano.
    for (const tarjeta of document.querySelectorAll<HTMLElement>("[data-sparkline]")) {
        const svg = tarjeta.querySelector("svg")!;
        const guia = svg.querySelector("[data-guia]")!;
        const marca = svg.querySelector("[data-marca]")!;
        const lectura = tarjeta.querySelector("[data-lectura]")!;
        const puntos: [number, number][] = JSON.parse(tarjeta.dataset.puntos!);
        const serie: [string, number][] = JSON.parse(tarjeta.dataset.serie!);
        const decimales = Number(tarjeta.dataset.decimales);
        const moneda = new Intl.NumberFormat("es-CL", {
            style: "currency",
            currency: tarjeta.dataset.unidad,
            minimumFractionDigits: decimales,
            maximumFractionDigits: decimales,
        });
        const dia = new Intl.DateTimeFormat("es-CL", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
        const textoOriginal = lectura.textContent;
        let actual = puntos.length - 1;

        const mostrar = (i: number) => {
            actual = Math.max(0, Math.min(puntos.length - 1, i));
            const [x, y] = puntos[actual];
            const [fecha, valor] = serie[actual];
            guia.setAttribute("x1", String(x));
            guia.setAttribute("x2", String(x));
            marca.setAttribute("cx", String(x));
            marca.setAttribute("cy", String(y));
            guia.setAttribute("visibility", "visible");
            marca.setAttribute("visibility", "visible");
            lectura.textContent = `${moneda.format(valor)} · ${dia.format(new Date(`${fecha}T00:00:00Z`))}`;
        };
        const ocultar = () => {
            guia.setAttribute("visibility", "hidden");
            marca.setAttribute("visibility", "hidden");
            lectura.textContent = textoOriginal;
        };
        const masCercano = (x: number) => {
            let mejor = 0;
            for (let i = 1; i < puntos.length; i++) {
                if (Math.abs(puntos[i][0] - x) < Math.abs(puntos[mejor][0] - x)) mejor = i;
            }
            return mejor;
        };

        svg.addEventListener("pointermove", (evento) => {
            const caja = svg.getBoundingClientRect();
            mostrar(masCercano(((evento.clientX - caja.left) / caja.width) * svg.viewBox.baseVal.width));
        });
        svg.addEventListener("pointerleave", ocultar);
        svg.addEventListener("focus", () => mostrar(actual));
        svg.addEventListener("blur", ocultar);
        svg.addEventListener("keydown", (evento) => {
            const salto = evento.shiftKey ? 20 : 1;
            if (evento.key === "ArrowLeft") mostrar(actual - salto);
            else if (evento.key === "ArrowRight") mostrar(actual + salto);
            else if (evento.key === "Home") mostrar(0);
            else if (evento.key === "End") mostrar(puntos.length - 1);
            else return;
            evento.preventDefault();
        });
    }
</script>
