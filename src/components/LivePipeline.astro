---
import Flow from "./Flow.astro";
import ArrowUpRight from "../icons/ArrowUpRight.astro";
import { localeDe, type Idioma } from "../i18n";
import { ui } from "../i18n/ui";
import { formatos, nombre, resumen, sparkline } from "../utils/indicadores";

interface Props {
    lang: Idioma;
}
const { lang } = Astro.props;
const t = ui[lang].pipeline;
const f = formatos(lang);
const { indicadores, dias_variacion: dias } = resumen;
const REPO = "https://github.com/DanielPonsG/Portfolio-dev";

const variacion = (valor: number | null) => {
    if (valor === null) return t.sinComparar;
    if (valor === 0) return t.sinCambio(dias);
    return `${valor > 0 ? "▲" : "▼"} ${f.porcentaje(Math.abs(valor))} ${t.enDias(dias)}`;
};

// Geometría de las sparklines, en unidades del viewBox.
const ANCHO = 300;
const ALTO = 72;

const enlaces = [
    { href: `${REPO}/tree/main/pipeline`, texto: t.codigo },
    { href: `${REPO}/actions/workflows/pipeline.yml`, texto: t.ejecuciones },
    { href: `${REPO}/blob/main/data/indicadores.csv`, texto: t.csv },
];
---

<!-- PIPELINE EN VIVO: RESULTADO DE LA ÚLTIMA EJECUCIÓN DEL ETL -->
<div class="p-5 border sm:p-6 rounded-2xl border-borde bg-superficie">
    <Flow pasos={t.pasos} etiqueta={ui[lang].caso.flujo} />

    <p class="flex items-start mt-4 text-sm gap-x-2 text-tinta-2">
        {
            resumen.generado ? (
                <>
                    <span class="relative flex size-2 mt-1.5 shrink-0" aria-hidden="true">
                        <span class="absolute inline-flex w-full h-full rounded-full opacity-75 motion-safe:animate-ping bg-vivo" />
                        <span class="relative inline-flex rounded-full size-2 bg-vivo" />
                    </span>
                    <span>
                        {t.ultimaEjecucion}: <strong class="font-semibold text-tinta">{f.fechaHora(resumen.generado)}</strong>{" "}
                        {`(${t.horaChile}) · ${f.entero(resumen.registros)} ${t.registros}`}
                    </span>
                </>
            ) : (
                <span>{t.pendiente}</span>
            )
        }
    </p>

    {
        indicadores.length > 0 && (
            <div class="grid gap-4 mt-5 sm:grid-cols-2">
                {indicadores.map((indicador) => {
                    const { puntos, linea, area, ultimo, minimo, maximo } = sparkline(indicador.serie, ANCHO, ALTO);
                    const valor = (v: number) => f.moneda(v, indicador.unidad, indicador.decimales);
                    const titulo = nombre(indicador, lang);
                    return (
                        <article
                            class="p-4 border rounded-xl border-borde bg-superficie-2/60"
                            data-sparkline
                            data-puntos={JSON.stringify(puntos)}
                            data-serie={JSON.stringify(indicador.serie)}
                            data-unidad={indicador.unidad}
                            data-decimales={indicador.decimales}
                            data-locale={localeDe[lang]}
                        >
                            <h3 class="text-sm font-medium text-tinta-2">{titulo}</h3>
                            <p class="text-2xl font-semibold tracking-tight tabular-nums text-tinta">
                                {valor(indicador.ultimo.valor)}
                            </p>
                            <p class="text-sm tabular-nums text-tinta-2">{variacion(indicador.variacion)}</p>
                            <svg
                                class="block w-full h-auto mt-3 overflow-visible rounded-sm cursor-crosshair"
                                viewBox={`0 0 ${ANCHO} ${ALTO}`}
                                role="img"
                                tabindex="0"
                                aria-label={t.graficoAria(titulo, valor(minimo), valor(maximo))}
                            >
                                <path d={area} class="fill-acento/10" />
                                <path
                                    d={linea}
                                    fill="none"
                                    class="stroke-acento"
                                    stroke-width="2"
                                    stroke-linejoin="round"
                                    stroke-linecap="round"
                                    vector-effect="non-scaling-stroke"
                                />
                                <line
                                    data-guia
                                    y1="0"
                                    y2={ALTO}
                                    class="stroke-tinta-2/60"
                                    stroke-width="1"
                                    vector-effect="non-scaling-stroke"
                                    visibility="hidden"
                                />
                                <circle cx={ultimo[0]} cy={ultimo[1]} r="4" class="fill-acento stroke-superficie" stroke-width="2" />
                                <circle data-marca r="4" class="fill-acento stroke-superficie" stroke-width="2" visibility="hidden" />
                            </svg>
                            <p class="mt-1 text-xs text-tinta-2" data-lectura aria-live="polite">
                                {t.al} {f.dia(indicador.ultimo.fecha)} · {t.ultimos12}
                            </p>
                        </article>
                    );
                })}
            </div>
        )
    }

    {
        indicadores.length > 0 && (
            <details class="mt-4 text-sm text-tinta">
                <summary class="font-medium cursor-pointer text-acento">{t.tabla}</summary>
                <div class="mt-2 overflow-x-auto">
                    <table class="w-full text-left tabular-nums">
                        <thead class="text-tinta-2">
                            <tr>
                                <th class="py-1 font-medium pe-4">{t.columnas[0]}</th>
                                <th class="py-1 font-medium pe-4">{t.columnas[1]}</th>
                                <th class="py-1 font-medium text-right pe-4">{t.columnas[2]}</th>
                                <th class="py-1 font-medium text-right">
                                    {t.columnas[3]} ({t.enDias(dias)})
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {indicadores.map((indicador) => (
                                <tr class="border-t border-borde">
                                    <td class="py-1 pe-4">{nombre(indicador, lang)}</td>
                                    <td class="py-1 pe-4 whitespace-nowrap">{f.dia(indicador.ultimo.fecha)}</td>
                                    <td class="py-1 text-right pe-4 whitespace-nowrap">
                                        {f.moneda(indicador.ultimo.valor, indicador.unidad, indicador.decimales)}
                                    </td>
                                    <td class="py-1 text-right whitespace-nowrap">
                                        {indicador.variacion === null ? "–" : f.porcentaje(indicador.variacion)}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </details>
        )
    }

    <ul class="flex flex-wrap mt-5 text-sm font-medium gap-x-5 gap-y-2">
        {
            enlaces.map(({ href, texto }) => (
                <li>
                    <a class="inline-flex items-center gap-x-1 text-acento hover:underline" href={href} target="_blank" rel="noopener noreferrer">
                        {texto}
                        <ArrowUpRight class="size-3.5" aria-hidden="true" />
                    </a>
                </li>
            ))
        }
        <li class="text-tinta-2">
            {t.fuente}: <a class="text-acento hover:underline" href="https://mindicador.cl" target="_blank" rel="noopener noreferrer">mindicador.cl</a>
        </li>
    </ul>
</div>

<script>
    // Crosshair de las sparklines: con el puntero o con las flechas del teclado
    // se muestra el valor y la fecha del punto más cercano.
    for (const tarjeta of document.querySelectorAll<HTMLElement>("[data-sparkline]")) {
        const svg = tarjeta.querySelector("svg")!;
        const guia = svg.querySelector("[data-guia]")!;
        const marca = svg.querySelector("[data-marca]")!;
        const lectura = tarjeta.querySelector("[data-lectura]")!;
        const puntos: [number, number][] = JSON.parse(tarjeta.dataset.puntos!);
        const serie: [string, number][] = JSON.parse(tarjeta.dataset.serie!);
        const decimales = Number(tarjeta.dataset.decimales);
        const locale = tarjeta.dataset.locale;
        const moneda = new Intl.NumberFormat(locale, {
            style: "currency",
            currency: tarjeta.dataset.unidad,
            minimumFractionDigits: decimales,
            maximumFractionDigits: decimales,
        });
        const dia = new Intl.DateTimeFormat(locale, { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
        const textoOriginal = lectura.textContent;
        let actual = puntos.length - 1;

        const mostrar = (i: number) => {
            actual = Math.max(0, Math.min(puntos.length - 1, i));
            const [x, y] = puntos[actual];
            const [fecha, valor] = serie[actual];
            guia.setAttribute("x1", String(x));
            guia.setAttribute("x2", String(x));
            marca.setAttribute("cx", String(x));
            marca.setAttribute("cy", String(y));
            guia.setAttribute("visibility", "visible");
            marca.setAttribute("visibility", "visible");
            lectura.textContent = `${moneda.format(valor)} · ${dia.format(new Date(`${fecha}T00:00:00Z`))}`;
        };
        const ocultar = () => {
            guia.setAttribute("visibility", "hidden");
            marca.setAttribute("visibility", "hidden");
            lectura.textContent = textoOriginal;
        };
        const masCercano = (x: number) => {
            let mejor = 0;
            for (let i = 1; i < puntos.length; i++) {
                if (Math.abs(puntos[i][0] - x) < Math.abs(puntos[mejor][0] - x)) mejor = i;
            }
            return mejor;
        };

        svg.addEventListener("pointermove", (evento) => {
            const caja = svg.getBoundingClientRect();
            mostrar(masCercano(((evento.clientX - caja.left) / caja.width) * svg.viewBox.baseVal.width));
        });
        svg.addEventListener("pointerleave", ocultar);
        svg.addEventListener("focus", () => mostrar(actual));
        svg.addEventListener("blur", ocultar);
        svg.addEventListener("keydown", (evento) => {
            const salto = evento.shiftKey ? 20 : 1;
            if (evento.key === "ArrowLeft") mostrar(actual - salto);
            else if (evento.key === "ArrowRight") mostrar(actual + salto);
            else if (evento.key === "Home") mostrar(0);
            else if (evento.key === "End") mostrar(puntos.length - 1);
            else return;
            evento.preventDefault();
        });
    }
</script>
