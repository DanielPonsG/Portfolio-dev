---
import School from "../icons/School.astro";
import Certificate from "../icons/Certificate.astro";
import type { Idioma } from "../i18n";
import { ui } from "../i18n/ui";
import { formacion } from "../data/perfil";

interface Props {
    lang: Idioma;
}
const { lang } = Astro.props;
const t = ui[lang].secciones.formacion;
const { titulos, certificados, cursos } = formacion[lang];
---

<!-- TÍTULOS, CERTIFICADOS Y CURSOS DESTACADOS -->
<div class="grid gap-4 md:grid-cols-2">
    <ul class="grid gap-4">
        {
            titulos.map(({ titulo, institucion, fecha }) => (
                <li class="flex p-5 border gap-x-4 rounded-2xl border-borde bg-superficie">
                    <span class="grid rounded-xl size-10 shrink-0 place-items-center bg-acento-suave text-acento">
                        <School class="size-5" aria-hidden="true" />
                    </span>
                    <div>
                        <h3 class="font-semibold text-tinta">{titulo}</h3>
                        <p class="text-sm text-tinta-2">
                            {institucion} · {fecha}
                        </p>
                    </div>
                </li>
            ))
        }
    </ul>

    <div class="p-5 border rounded-2xl border-borde bg-superficie">
        <h3 class="flex items-center font-semibold gap-x-2 text-tinta">
            <Certificate class="size-5 text-acento" aria-hidden="true" />
            {t.certificados}
        </h3>
        <p class="text-sm text-tinta-2">{t.certificadosFecha}</p>
        <ul class="mt-3 space-y-1.5 text-tinta-2">
            {
                certificados.map((certificado) => (
                    <li class="flex gap-x-3">
                        <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-acento/60" aria-hidden="true" />
                        {certificado}
                    </li>
                ))
            }
        </ul>
    </div>

    <div class="p-5 border md:col-span-2 rounded-2xl border-borde bg-superficie">
        <h3 class="font-semibold text-tinta">{t.cursos}</h3>
        <ul class="flex flex-wrap gap-1.5 mt-3">
            {cursos.map((curso) => <li class="px-2 py-0.5 text-xs rounded-md bg-superficie-2 text-tinta">{curso}</li>)}
        </ul>
    </div>
</div>
