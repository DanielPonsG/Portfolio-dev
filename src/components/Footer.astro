---
import ArrowUp from "../icons/ArrowUp.astro";
import type { Idioma } from "../i18n";
import { ui } from "../i18n/ui";

interface Props {
    lang: Idioma;
}
const { lang } = Astro.props;
const t = ui[lang].footer;
const anio = new Date().getFullYear();
---

<!-- PIE DE PÁGINA -->
<footer class="mt-24 border-t border-borde">
    <div class="flex flex-col max-w-5xl gap-4 px-4 py-8 mx-auto text-sm sm:px-6 sm:flex-row sm:items-center sm:justify-between text-tinta-2">
        <div class="space-y-1">
            <p>© {anio} Daniel Pons González · {t.hecho}</p>
            <p class="text-xs">{t.avatar}</p>
        </div>
        <a href="#arriba" class="inline-flex items-center gap-x-1.5 font-medium hover:text-acento shrink-0">
            <ArrowUp class="size-4" aria-hidden="true" />
            {t.arriba}
        </a>
    </div>
</footer>
