---
import Avatar from "./Avatar.astro";
import Badge from "./Badge.astro";
import ArrowRight from "../icons/ArrowRight.astro";
import Mail from "../icons/Mail.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import GitHub from "../icons/GitHub.astro";
import { seccion, type Idioma } from "../i18n";
import { ui } from "../i18n/ui";
import { formatos, nombre, resumen, sparkline } from "../utils/indicadores";

interface Props {
    lang: Idioma;
}
const { lang } = Astro.props;
const t = ui[lang];
const f = formatos(lang);

const redes = [
    { href: "https://www.linkedin.com/in/danielponsg", label: "LinkedIn", icono: LinkedIn },
    { href: "https://github.com/DanielPonsG", label: "GitHub", icono: GitHub },
];

// Mini tarjeta: el primer indicador con su sparkline y el resto en lista.
const [principal, ...resto] = resumen.indicadores;
const grafico = principal ? sparkline(principal.serie, 240, 56, 4) : null;
const valor = (v: number, unidad: string, decimales: number) => f.moneda(v, unidad, decimales);
const flecha = (variacion: number | null) => (variacion === null || variacion === 0 ? "" : variacion > 0 ? "▲" : "▼");
---

<!-- PRESENTACIÓN: AVATAR, PROPUESTA, LLAMADOS A LA ACCIÓN Y EVIDENCIA EN VIVO -->
<section id="inicio" class="w-full max-w-5xl px-4 pt-12 pb-16 mx-auto sm:px-6 md:pt-20 md:pb-24">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-14">
        <div class="min-w-0">
            <div class="flex flex-col items-start gap-y-5 sm:flex-row sm:items-center sm:gap-x-10 mb-7">
                <Avatar class="size-24 sm:size-28 md:size-32" alt={t.hero.avatar} />
                <div class="flex flex-col items-start min-w-0 gap-y-3">
                    <p class="font-mono text-xs font-medium tracking-widest uppercase text-acento">{t.hero.antetitulo}</p>
                    <Badge>{t.hero.badge}</Badge>
                </div>
            </div>

            <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl text-tinta">Daniel Pons</h1>
            <p class="max-w-2xl mt-4 text-xl font-medium md:text-2xl text-balance text-tinta">{t.hero.subtitulo}</p>
            <p class="max-w-2xl mt-4 text-base md:text-lg text-pretty text-tinta-2">{t.hero.intro}</p>

            <div class="flex flex-wrap items-center gap-3 mt-8">
                <a
                    href={seccion(lang, "casos")}
                    class="inline-flex items-center px-5 font-medium transition-opacity rounded-lg gap-x-2 h-11 bg-acento text-acento-tinta hover:opacity-90"
                >
                    {t.hero.verCasos}
                    <ArrowRight class="size-4" aria-hidden="true" />
                </a>
                <a
                    href={seccion(lang, "contacto")}
                    class="inline-flex items-center px-5 font-medium transition-colors border rounded-lg gap-x-2 h-11 border-borde bg-superficie text-tinta hover:border-acento"
                >
                    <Mail class="size-4" aria-hidden="true" />
                    {t.hero.contactar}
                </a>
                <ul class="flex items-center gap-x-1 ms-1">
                    {
                        redes.map(({ href, label, icono: Icono }) => (
                            <li>
                                <a
                                    href={href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={label}
                                    class="grid transition-colors rounded-lg size-11 place-items-center text-tinta-2 hover:text-acento"
                                >
                                    <Icono class="size-5" aria-hidden="true" />
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <aside class="min-w-0 p-5 border shadow-sm rounded-2xl border-borde bg-superficie shadow-acento/5" aria-labelledby="mini-pipeline">
            <div class="flex items-center justify-between mb-4">
                <h2 id="mini-pipeline" class="flex items-center font-mono text-xs font-semibold tracking-widest uppercase gap-x-2 text-tinta">
                    <span class="relative flex size-2" aria-hidden="true">
                        <span class="absolute inline-flex w-full h-full rounded-full opacity-75 motion-safe:animate-ping bg-vivo"></span>
                        <span class="relative inline-flex rounded-full size-2 bg-vivo"></span>
                    </span>
                    {t.pipeline.enVivo}
                </h2>
                <span class="font-mono text-[11px] text-tinta-2">Python · Actions</span>
            </div>

            {
                principal && grafico ? (
                    <>
                        <p class="text-sm text-tinta-2">{nombre(principal, lang)}</p>
                        <p class="text-3xl font-semibold tracking-tight tabular-nums text-tinta">
                            {valor(principal.ultimo.valor, principal.unidad, principal.decimales)}
                        </p>
                        <svg class="block w-full h-auto mt-2 overflow-visible" viewBox="0 0 240 56" aria-hidden="true">
                            <path d={grafico.area} class="fill-acento/10" />
                            <path
                                d={grafico.linea}
                                fill="none"
                                class="stroke-acento"
                                stroke-width="2"
                                stroke-linejoin="round"
                                vector-effect="non-scaling-stroke"
                            />
                            <circle cx={grafico.ultimo[0]} cy={grafico.ultimo[1]} r="3.5" class="fill-acento stroke-superficie" stroke-width="2" />
                        </svg>
                        <ul class="mt-4 text-sm divide-y divide-borde">
                            {resto.map((indicador) => (
                                <li class="flex items-baseline justify-between py-2 gap-x-3">
                                    <span class="truncate text-tinta-2">{nombre(indicador, lang)}</span>
                                    <span class="font-medium tabular-nums whitespace-nowrap text-tinta">
                                        {valor(indicador.ultimo.valor, indicador.unidad, indicador.decimales)}
                                        <span class="ms-1 text-xs text-tinta-2">{flecha(indicador.variacion)}</span>
                                    </span>
                                </li>
                            ))}
                        </ul>
                        {resumen.generado && (
                            <p class="mt-3 text-xs text-tinta-2">
                                {t.pipeline.actualizado}: {f.dia(resumen.generado.slice(0, 10))}
                            </p>
                        )}
                    </>
                ) : (
                    <>
                        <ol class="space-y-2 font-mono text-xs text-tinta">
                            {t.pipeline.pasos.map((paso, i) => (
                                <li class="flex items-center gap-x-3">
                                    <span class="grid rounded-md size-6 shrink-0 place-items-center bg-acento-suave text-acento">{i + 1}</span>
                                    {paso}
                                </li>
                            ))}
                        </ol>
                        <p class="mt-4 text-sm text-tinta-2">{t.pipeline.pendiente}</p>
                    </>
                )
            }

            <a href={seccion(lang, "pipeline")} class="inline-flex items-center mt-4 text-sm font-medium gap-x-1 text-acento hover:underline">
                {t.pipeline.verPipeline}
                <ArrowRight class="size-4" aria-hidden="true" />
            </a>
        </aside>
    </div>

    <dl class="grid gap-4 mt-12 sm:grid-cols-3">
        {
            t.destacados.map(({ valor, etiqueta }) => (
                <div class="flex flex-col-reverse justify-end p-5 border rounded-2xl border-borde bg-superficie">
                    <dt class="mt-1 text-sm text-tinta-2">{etiqueta}</dt>
                    <dd class="text-3xl font-semibold tracking-tight text-acento">{valor}</dd>
                </div>
            ))
        }
    </dl>
</section>
