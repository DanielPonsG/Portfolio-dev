---
import type { Idioma } from "../i18n";
import { experiencia } from "../data/perfil";

interface Props {
    lang: Idioma;
}
const { lang } = Astro.props;
---

<!-- LÍNEA DE TIEMPO DE EXPERIENCIA LABORAL -->
<ol class="relative border-s border-borde ms-2">
    {
        experiencia[lang].map(({ cargo, empresa, fecha, logros }, i) => (
            <li class="pb-10 ps-7 last:pb-0">
                <span
                    class={`absolute -start-[7px] mt-1.5 size-3.5 rounded-full ring-4 ring-fondo ${i === 0 ? "bg-acento" : "bg-borde"}`}
                    aria-hidden="true"
                />
                <p class="font-mono text-xs font-medium tracking-wide uppercase text-tinta-2">{fecha}</p>
                <h3 class="mt-1 text-lg font-semibold md:text-xl text-tinta">
                    {cargo} <span class="font-normal text-tinta-2">· {empresa}</span>
                </h3>
                <ul class="max-w-3xl mt-3 space-y-2 text-tinta-2">
                    {logros.map((logro) => (
                        <li class="flex gap-x-3">
                            <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-acento/60" aria-hidden="true" />
                            <span>{logro}</span>
                        </li>
                    ))}
                </ul>
            </li>
        ))
    }
</ol>
