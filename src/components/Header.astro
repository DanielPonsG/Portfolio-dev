---
// En pantallas pequeñas solo caben algunos enlaces; el resto se muestra desde sm.
const links = [
    { href: "#experiencia", label: "Experiencia", mobile: true },
    { href: "#casos", label: "Casos", mobile: true },
    { href: "#stack", label: "Stack", mobile: false },
    { href: "#proyectos", label: "Proyectos", mobile: true },
    { href: "#formacion", label: "Formación", mobile: false },
    { href: "#contacto", label: "Contacto", mobile: true },
];
---

<header class="flex fixed justify-center items-center py-5 w-full xl:w-[1265px] mx-auto left-auto rounded-xs z-10 backdrop-blur-xs">

    <nav class="flex flex-row gap-x-5 md:gap-x-8 opacity-80 text-sm md:text-base">
        {
            links.map(({ href, label, mobile }) => (
                <a class={`transition-all hover:scale-110 hover:text-blue-500 ${mobile ? "" : "hidden sm:inline"}`} href={href}>
                    {label}
                </a>
            ))
        }
    </nav>

</header>
