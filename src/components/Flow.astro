---
import ArrowRight from "../icons/ArrowRight.astro";

interface Props {
    pasos: string[];
    etiqueta?: string;
}
const { pasos, etiqueta = "Flujo de datos" } = Astro.props;
---

<!-- PASOS DE UN FLUJO DE DATOS, UNIDOS POR FLECHAS -->
<ol class="flex flex-wrap items-center gap-y-2 font-mono text-[11px] font-medium" aria-label={etiqueta}>
    {pasos.map((paso, i) => (
        <li class="flex items-center">
            {i > 0 && <ArrowRight class="size-3.5 mx-1 text-tinta-2" aria-hidden="true" />}
            <span class="px-2 py-1 border rounded-md text-tinta border-borde bg-superficie-2">{paso}</span>
        </li>
    ))}
</ol>
